#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>
#define N 10

int main() {
    setlocale(LC_ALL, "Russian");
    float array[N] = { 1.1f, 2.2f, 3.3f, 4.4f, 5.5f, 6.6f, 7.7f, 8.8f, 9.9f, 10.1f };
    float *ptr_a;

    printf("--- 4.1. Имя массива - это адрес его первого элемента ---\n");
    printf("array       = %p\n", (void *)array);
    printf("&array[0]   = %p\n", (void *)&array[0]);
    printf("array + 0   = %p\n", (void *)(array + 0));
    printf("&array      = %p\n", (void *)&array);
    printf("\n--- 4.2. Операции с указателем ---\n");

    ptr_a = array;
    printf("ptr_a        = %p -> *ptr_a = %.2f\n", (void *)ptr_a, *ptr_a);

    ptr_a++;
    printf("ptr_a++      = %p -> *ptr_a = %.2f\n", (void *)ptr_a, *ptr_a);

    ptr_a = ptr_a + 4;
    printf("ptr_a + 4    = %p -> *ptr_a = %.2f\n", (void *)ptr_a, *ptr_a);

    ptr_a = ptr_a - 2;
    printf("ptr_a - 2    = %p -> *ptr_a = %.2f\n", (void *)ptr_a, *ptr_a);

    printf("\n--- 4.3. Прямой проход с шагом 2 ---\n");
    for (ptr_a = array; ptr_a < array + N; ptr_a = ptr_a + 2) {
        printf("адрес %p -> значение %.2f\n", (void *)ptr_a, *ptr_a);
    }
    printf("\n--- 4.4. Обратный проход с конца массива ---\n");
    ptr_a = array + N - 1;   // указатель на последний элемент
    while (ptr_a >= array) {
        printf("адрес %p -> значение %.2f\n", (void *)ptr_a, *ptr_a);
        ptr_a--;
    }
    return 0;
}
